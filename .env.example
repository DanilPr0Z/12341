# ==============================================
# PADDLE BOOKING — переменные окружения
# Скопируйте: cp .env.example .env
# ==============================================

# --- Django ---
# Генерация: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-замените-на-реальный-ключ

# False в продакшене, True только для разработки
DEBUG=False

# Ваш домен, например: mysite.ru,www.mysite.ru
ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных PostgreSQL ---
# Формат: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://paddle_user:password@localhost:5432/paddle_booking

# --- Email (Gmail) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your@gmail.com

# --- Сайт ---
SITE_NAME=Paddle Booking
SITE_URL=https://ваш-домен.ru

# --- Безопасность ---
SECURE_SSL_REDIRECT=True
CORS_ALLOWED_ORIGINS=https://ваш-домен.ru
